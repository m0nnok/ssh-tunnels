<Window x:Class="SshTunneler.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Tunneler"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        MinWidth="280" MinHeight="160"
        Opacity="{Binding Ui.Opacity, Mode=OneWay}"
        Topmost="{Binding Ui.Topmost, Mode=OneWay}"
        MouseWheel="OnWindowMouseWheel">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid Margin="10,7,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding ToggleLogCommand}"
                            Content="&#x2261;" ToolTip="Лог подключений" />
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding OpenSettingsCommand}"
                            Content="&#x2699;" ToolTip="Настройки" />
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding HideCommand}"
                            Content="&#x2715;"
                            ToolTip="Свернуть в трей (выход — из меню в трее)" />
                </StackPanel>
                <TextBlock Text="SSH Tunnels" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock Text="Ресурсов пока нет. Откройте настройки и добавьте сервер и ресурс."
                               TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="11"
                               Margin="2,6,2,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResources}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TunnelButton}"
                                        Command="{Binding ToggleCommand}"
                                        ToolTip="{Binding ToolTipText}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Открыть в браузере" Command="{Binding OpenBrowserCommand}" />
                                            <MenuItem Header="Копировать URL" Command="{Binding CopyUrlCommand}" />
                                            <Separator />
                                            <MenuItem Header="Переподключить" Command="{Binding ReconnectCommand}" />
                                            <MenuItem Header="Отключить" Command="{Binding DisconnectCommand}" />
                                            <Separator />
                                            <MenuItem Header="Показать лог" Command="{Binding ShowLogCommand}" />
                                            <MenuItem Header="Изменить..." Command="{Binding EditCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Margin="15,2,0,0"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="0,6,0,0" Padding="6" CornerRadius="6"
                    Background="{StaticResource InputBrush}"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LogTitle}" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding LogLines}" MaxHeight="150" FontFamily="Consolas"
                             FontSize="10" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding StatusLine}" FontSize="10" Margin="2,6,18,0"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>

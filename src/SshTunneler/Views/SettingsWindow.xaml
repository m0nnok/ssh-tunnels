<Window x:Class="SshTunneler.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SshTunneler.Views"
        Title="SSH Tunneler — настройки"
        Width="720" Height="520" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1B1F"
        Foreground="{StaticResource TextBrush}"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <views:AuthMethodNameConverter x:Key="AuthMethodName" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource BorderBrushSoft}">
            <TabItem Header="Серверы">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                            <Button Content="Добавить" Style="{StaticResource DialogButton}"
                                    Command="{Binding AddServerCommand}" />
                            <Button Content="Удалить" Style="{StaticResource DialogButton}"
                                    Command="{Binding DeleteServerCommand}" />
                            </StackPanel>
                            <Button Content="Проверить подключение" Style="{StaticResource DialogButton}"
                                    Margin="0,6,0,0" Command="{Binding TestConnectionCommand}" />
                            <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                 DisplayMemberPath="Name" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding SelectedServer, Converter={x:Static views:NullToBoolConverter.Instance}}">
                        <StackPanel DataContext="{Binding SelectedServer}">
                            <Label Content="Название" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Хост (или Host-алиас из ssh config)" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Порт SSH" />
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                     HorizontalAlignment="Left" />
                            <Label Content="Пользователь" />
                            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Аутентификация" />
                            <ComboBox ItemsSource="{Binding DataContext.AuthMethods,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding AuthMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AuthMethodName}}"
                                                   Foreground="Black" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Label Content="Файл приватного ключа" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор..." Style="{StaticResource DialogButton}"
                                        Margin="6,0,0,6" Click="OnBrowseKey" />
                                <TextBox Text="{Binding KeyPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <Label Content="Passphrase / пароль (хранится зашифрованным)" />
                            <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" />
                            <Label Content="Дополнительные опции ssh, например -o ProxyJump=bastion" />
                            <TextBox Text="{Binding ExtraOptions, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Ресурсы">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Добавить" Style="{StaticResource DialogButton}"
                                        Command="{Binding AddResourceCommand}" />
                                <Button Content="Удалить" Style="{StaticResource DialogButton}"
                                        Command="{Binding DeleteResourceCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Выше" Style="{StaticResource DialogButton}"
                                        Command="{Binding MoveResourceUpCommand}" />
                                <Button Content="Ниже" Style="{StaticResource DialogButton}"
                                        Command="{Binding MoveResourceDownCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="ResourceList" ItemsSource="{Binding Resources}"
                                 SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding SelectedResource, Converter={x:Static views:NullToBoolConverter.Instance}}">
                        <StackPanel DataContext="{Binding SelectedResource}">
                            <Label Content="Название кнопки" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Описание" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Сервер" />
                            <ComboBox ItemsSource="{Binding DataContext.Servers,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValue="{Binding ServerId}" SelectedValuePath="Id"
                                      DisplayMemberPath="Name" />
                            <Label Content="Адрес на сервере (обычно 127.0.0.1)" />
                            <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Порт на сервере" />
                            <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                     HorizontalAlignment="Left" />
                            <Label Content="Локальный порт (0 — выбрать свободный автоматически)" />
                            <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                     HorizontalAlignment="Left" />
                            <Label Content="URL: поддерживаются {localPort}, {remotePort}, {remoteHost}" />
                            <TextBox Text="{Binding UrlTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Открывать в браузере после подключения"
                                      IsChecked="{Binding AutoOpenBrowser}" />
                            <CheckBox Content="Подключать при запуске приложения"
                                      IsChecked="{Binding AutoConnectOnStart}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Общие">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Ui}">
                        <Label Content="Прозрачность окна" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                       Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                            <Slider Minimum="0.35" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Opacity}" />
                        </DockPanel>
                        <CheckBox Content="Поверх всех окон" IsChecked="{Binding Topmost}" />
                        <CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding AutoStartWithWindows}" />
                        <CheckBox Content="Стартовать свёрнутым в трей" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="Автоматически переподключать упавшие туннели"
                                  IsChecked="{Binding AutoReconnect}" />
                        <Label Content="Диапазон локальных портов для автоподбора" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding LocalPortRangeStart, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90" />
                            <TextBlock Text=" — " VerticalAlignment="Center" Margin="6,0,6,6" />
                            <TextBox Text="{Binding LocalPortRangeEnd, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90" />
                        </StackPanel>
                        <Label Content="Браузер (пусто — системный по умолчанию)" />
                        <TextBox Text="{Binding BrowserPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Сохранить" Style="{StaticResource DialogButton}" Click="OnSave" />
                <Button Content="Отмена" Style="{StaticResource DialogButton}" Click="OnCancel" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#E05454" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
